  {
    "rule_id": "rr-percentage-range",
    "mode": "dqx_native",
    "status": "approved",
    "version": 1,
    "definition": {
      "body": {"function": "is_in_range", "arguments": {"column": "{{column}}", "min_limit": 0, "max_limit": 100}},
      "slots": [{"name": "column", "family": "numeric", "position": 0, "cardinality": "one", "arg_key": "column"}],
      "parameters": [
        {"name": "min_limit", "type": "number", "value": 0},
