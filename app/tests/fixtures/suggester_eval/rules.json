  {
    "rule_id": "rr-max-length",
    "mode": "sql",
    "status": "approved",
    "version": 1,
    "polarity": "pass",
    "definition": {
      "body": {"predicate": "length({{column}}) <= 255"},
      "slots": [{"name": "column", "family": "text", "position": 0, "cardinality": "one"}],
      "parameters": [{"name": "max_length", "type": "number", "value": 255}]
    },
    "user_metadata": {
      "name": "Text length within bound",
      "description": "The text column must not exceed the agreed maximum character length.",
      "dimension": "Validity",
      "severity": "Low"
    }
  }
