[
  {
    "binding_id": "b-customers",
    "table_fqn": "eval.golden.customers",
    "note": "Baseline shape: one obvious identity column, one obvious format column, and a decoy (secondary_contact) that a careless judge binds the email rule to.",
    "columns": [
      {
        "name": "customer_id",
        "type": "STRING",
        "comment": "Primary key, one row per customer"
      },
      {
        "name": "email",
        "type": "STRING",
        "comment": "Customer contact email address"
      },
      {
        "name": "secondary_contact",
        "type": "STRING",
        "comment": "Optional free-text note about how else to reach the customer"
      },
      {
        "name": "country_code",
        "type": "STRING",
        "comment": "ISO 3166-1 alpha-2 country code"
      },
      {
        "name": "created_at",
        "type": "TIMESTAMP",
        "comment": "Row creation timestamp"
      },
      {
        "name": "lifetime_value",
        "type": "DECIMAL(18,2)",
        "comment": "Total revenue attributed to the customer to date"
      }
    ]
  },
  {
    "binding_id": "b-orders",
    "table_fqn": "eval.golden.orders",
    "note": "Carries the multi-slot case (ordered_at before shipped_at) and a foreign key that must NOT attract the uniqueness rule.",
    "columns": [
      {
        "name": "order_id",
        "type": "STRING",
        "comment": "Primary key of the order"
      },
      {
        "name": "customer_id",
        "type": "STRING",
        "comment": "Foreign key to customers.customer_id; repeats across orders"
      },
      {
        "name": "order_total",
        "type": "DECIMAL(18,2)",
        "comment": "Order gross total, expressed in order_currency"
      },
      {
        "name": "order_currency",
        "type": "STRING",
        "comment": "ISO 4217 currency code for order_total"
      },
      {
        "name": "ordered_at",
        "type": "TIMESTAMP",
        "comment": "When the order was placed"
      },
      {
        "name": "shipped_at",
        "type": "TIMESTAMP",
        "comment": "When the order shipped; null until dispatch"
      },
      {
        "name": "status",
        "type": "STRING",
        "comment": "Order state: one of NEW, PAID, SHIPPED, CANCELLED"
      }
    ]
  },
  {
    "binding_id": "b-raw-landing",
    "table_fqn": "eval.golden.raw_landing",
    "note": "The table whose correct answer is nothing. Both columns are documented as legitimately null, so even the universal not-null rule is wrong here.",
    "columns": [
      {
        "name": "payload",
        "type": "STRING",
        "comment": "Raw unparsed vendor payload; null is expected while a backfill is in flight"
      },
      {
        "name": "ingest_batch",
        "type": "STRING",
        "comment": "Optional batch tag, left null for streaming arrivals"
      }
    ]
  },
  {
    "binding_id": "b-invoices",
    "table_fqn": "eval.golden.invoices",
    "note": "Two columns compete for the same rule: budget_amount and actual_spend are both correct for the positive-amount rule, so both are labelled and a judge that picks only one loses recall. due_at is legitimately in the future.",
    "columns": [
      {
        "name": "invoice_id",
        "type": "STRING",
        "comment": "Primary key of the invoice"
      },
      {
        "name": "vendor_email",
        "type": "STRING",
        "comment": "Vendor billing contact email address"
      },
      {
        "name": "budget_amount",
        "type": "DECIMAL(18,2)",
        "comment": "Approved budget amount for the invoice"
      },
      {
        "name": "actual_spend",
        "type": "DECIMAL(18,2)",
        "comment": "Actual amount spent against the approved budget"
      },
      {
        "name": "invoice_currency",
        "type": "STRING",
        "comment": "ISO 4217 currency code for the invoice amounts"
      },
      {
        "name": "issued_at",
        "type": "TIMESTAMP",
        "comment": "When the invoice was issued"
      },
      {
        "name": "due_at",
        "type": "TIMESTAMP",
        "comment": "When payment falls due; deliberately later than now"
      }
    ]
  },
  {
    "binding_id": "b-shipments",
    "table_fqn": "eval.golden.shipments",
    "note": "Second multi-slot case, plus a reversed binding in must_not_suggest: swapping the two temporal slots is structurally valid and semantically wrong.",
    "columns": [
      {
        "name": "shipment_id",
        "type": "STRING",
        "comment": "Primary key of the shipment"
      },
      {
        "name": "dispatched_at",
        "type": "TIMESTAMP",
        "comment": "When the shipment left the warehouse"
      },
      {
        "name": "delivered_at",
        "type": "TIMESTAMP",
        "comment": "When the shipment was delivered; null until arrival"
      },
      {
        "name": "estimated_delivery_at",
        "type": "TIMESTAMP",
        "comment": "Forecast delivery date, normally later than now"
      },
      {
        "name": "destination_country",
        "type": "STRING",
        "comment": "ISO 3166-1 alpha-2 destination country code"
      },
      {
        "name": "parcel_count",
        "type": "INT",
        "comment": "Count of parcels in the consignment"
      }
    ]
  },
  {
    "binding_id": "b-sensors",
    "table_fqn": "eval.golden.sensor_readings",
    "note": "Exercises family matching across numeric and temporal columns, plus a percentage bound.",
    "columns": [
      {
        "name": "reading_id",
        "type": "STRING",
        "comment": "Primary key of the reading"
      },
      {
        "name": "recorded_at",
        "type": "TIMESTAMP",
        "comment": "When the reading was taken"
      },
      {
        "name": "humidity_percent",
        "type": "DOUBLE",
        "comment": "Relative humidity expressed as a percentage"
      },
      {
        "name": "error_count",
        "type": "INT",
        "comment": "Count of transmission errors since the previous reading"
      },
      {
        "name": "sensor_url",
        "type": "STRING",
        "comment": "Management URL for the sensor device"
      }
    ]
  },
  {
    "binding_id": "b-employees",
    "table_fqn": "eval.golden.employees",
