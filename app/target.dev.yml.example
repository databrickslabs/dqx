# Copy to ``target.dev.yml`` (untracked) and fill in your values. databricks.yml
# includes ``target.*.yml`` and .gitignore excludes it, so your workspace profile,
# catalog, and service-principal id are never committed.
#
# The SQL warehouse is declared once in ``databricks.yml`` (bundle-managed,
# #1300 simplified deploy). Override ``sql_warehouse_name`` / ``sql_warehouse_size``
# here if you need a different size or display name per target.
targets:
  dev:
    default: true
    workspace:
      profile: <your-databricks-cli-profile>
    variables:
      catalog_name: <your-catalog>
      # Storage prefix: schemas become <prefix>, <prefix>_tmp, <prefix>_genie and
      # <prefix>_demo. Omit to use the default ``dqx_studio``. Also settable via
      # ``make app-deploy STUDIO_PREFIX=<prefix>``.
      # prefix: dqx_studio
      # Workspace group allowed to use Studio. Also settable via
      # ``make app-deploy STUDIO_USER_GROUP=<group>``. Use ``users`` for broad mode
      # (workspace ACLs use ``users``, UC grants use ``account users``; the Make
      # target sets ``studio_uc_principal`` for you, otherwise set it to
      # ``account users`` here).
      studio_user_group: <your-scoped-studio-user-group>
      # Application id of the service principal that runs the task-runner job.
      dqx_service_principal_application_id: <your-service-principal-application-id>
    presets:
      trigger_pause_status: PAUSED
