# Merge/report config for the MCP integration suite.
#
# This suite's code runs REMOTELY — the server in a deployed Databricks App, the runner in a
# serverless job — so all coverage data is produced there and shipped back through the mcp_results
# UC volume (see tests/integration_mcp/coverage_bootstrap). [paths] below maps those container
# paths onto repo paths so the merged report and Codecov line up.
#
# This is NOT the repo-root .coveragerc ([run] source = src, for the DQX library), so it must be
# passed explicitly, and combined from the REPO ROOT — a [paths] rule whose rewritten target does
# not exist on disk is silently skipped, which shows up as container paths in the report:
#
#   uv run coverage combine --rcfile=tests/integration_mcp/.coveragerc --keep
#   uv run coverage report  --rcfile=tests/integration_mcp/.coveragerc -m

[run]
# Must match the bootstrap's shipped coveragerc: combining branch ("arc") data with line data is a
# hard DataError.
branch = true
relative_files = true

[paths]
# First entry is the result path; the rest are patterns matched against recorded paths.
# App container source lives at /app/python/source_code/server; the runner is installed as a wheel
# into .../site-packages/dqx_mcp_runner (the env directory carries a per-run uuid).
server =
    mcp-server/server
    */source_code/server
runner =
    mcp-server/runner/src/dqx_mcp_runner
    */site-packages/dqx_mcp_runner

[report]
omit =
    # The test-only bootstrap itself is not part of the product surface.
    */dqx_mcp_coverage_bootstrap/*
    # Process entry point: argument/env plumbing plus uvicorn.run(), no business logic. The app
    # launches it as `python server/main.py`, so its module name is __main__ and source_pkgs never
    # attributes it anyway. Mirrors the root pyproject.toml, which omits
    # src/databricks/labs/dqx/__main__.py for the same reason.
    */server/main.py
exclude_lines =
    no cov
    if __name__ == .__main__.:
    # Defensive re-raise/guard branches for platform failures a test cannot induce.
    raise NotImplementedError
    # Type-checking-only imports never execute at runtime, by design. (The DQX library marks these
    # with `# pragma: no cover` at the source line instead — see
    # src/databricks/labs/dqx/datacontract/contract_rules_generator.py. Excluding by pattern here
    # keeps the MCP server source free of coverage awareness, since the same source is what a
    # production deploy ships.)
    if TYPE_CHECKING:
